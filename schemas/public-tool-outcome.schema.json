{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.local/schemas/public-tool-outcome.schema.json",
  "title": "PublicToolOutcomeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_id",
    "correlation_id",
    "idempotency_key",
    "project_id",
    "workspace_id",
    "workspace_generation",
    "conversation_ref",
    "task_id",
    "objective_id",
    "attempt_id",
    "run_id",
    "actor_id",
    "actor_role",
    "tool_name",
    "tool_category",
    "phase",
    "status",
    "started_at",
    "completed_at",
    "duration_ms",
    "public_title",
    "public_summary",
    "result_metrics",
    "findings",
    "evidence_refs",
    "result_digest",
    "redaction_applied",
    "truncated",
    "state_authority_changed"
  ],
  "properties": {
    "version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^tool-result:[a-f0-9]{24}$" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 300 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 500 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "workspace_generation": { "type": "integer", "minimum": 1 },
    "conversation_ref": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "task_id": { "type": ["string", "null"], "maxLength": 240 },
    "objective_id": { "type": ["string", "null"], "maxLength": 500 },
    "attempt_id": { "type": ["string", "null"], "maxLength": 240 },
    "run_id": { "type": ["string", "null"], "maxLength": 240 },
    "actor_id": { "type": ["string", "null"], "maxLength": 240 },
    "actor_role": { "enum": ["executor", "reviewer", "observer", "system"] },
    "tool_name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "tool_category": { "enum": ["read", "write", "validation", "browser", "git", "report", "other"] },
    "phase": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["completed", "failed", "blocked", "degraded"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "public_title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "public_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "result_metrics": {
      "type": "object",
      "maxProperties": 40,
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "evidence_refs"],
        "properties": {
          "kind": { "enum": ["finding", "warning"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence_refs": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 4096 } }
        }
      }
    },
    "evidence_refs": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 4096 } },
    "result_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "redaction_applied": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "state_authority_changed": { "const": false }
  }
}
