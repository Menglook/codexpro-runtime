{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.local/schemas/browser-flow-state.schema.json",
  "title": "CodexPro Browser Flow State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "flow_id", "contract_hash", "task_id", "run_id", "space_id", "status", "current_step_id", "steps", "resume_count", "created_at", "updated_at"],
  "properties": {
    "version": { "const": 1 },
    "flow_id": { "$ref": "#/$defs/non_empty" },
    "contract_hash": { "$ref": "#/$defs/sha256" },
    "task_id": { "$ref": "#/$defs/non_empty" },
    "run_id": { "$ref": "#/$defs/non_empty" },
    "space_id": { "$ref": "#/$defs/non_empty" },
    "status": { "enum": ["prepared", "queued", "running", "waiting_resource", "waiting_human", "passed", "failed", "blocked", "cancelled"] },
    "current_step_id": { "type": ["string", "null"] },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step_state" } },
    "resume_count": { "type": "integer", "minimum": 0 },
    "blocking_reason": { "type": "string" },
    "resource_wait": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relative_path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)" },
    "step_state": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "status", "input_hash", "recoverable", "retryable", "attempt_count", "evidence_paths"],
      "properties": {
        "step_id": { "$ref": "#/$defs/non_empty" },
        "status": { "enum": ["pending", "running", "passed", "failed", "blocked", "skipped", "waiting_human", "cancelled"] },
        "input_hash": { "$ref": "#/$defs/sha256" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "before_snapshot_id": { "type": "string" },
        "after_snapshot_id": { "type": "string" },
        "output": { "type": "object", "additionalProperties": true },
        "recoverable": { "type": "boolean" },
        "retryable": { "type": "boolean" },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "error_class": { "type": "string" },
        "error_message": { "type": "string" },
        "evidence_paths": { "type": "array", "items": { "$ref": "#/$defs/relative_path" } }
      }
    }
  }
}
