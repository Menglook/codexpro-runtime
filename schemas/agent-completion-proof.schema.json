{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.local/schemas/agent-completion-proof.schema.json",
  "title": "CodexPro Agent Completion Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proof_id", "parent_goal_id", "agent_id", "agent_role", "task_id", "task_contract_hash", "task_contract_version", "run_id", "owner_fingerprint", "fencing_token", "provider", "model_id", "sandbox_mode", "started_at", "terminal_at", "terminal_status", "terminal_event_id", "input_hash", "output_hash", "structured_result_hash", "workspace_before_hash", "workspace_after_hash", "changed_files", "changed_files_hash", "allowed_paths_hash", "workspace_boundary_valid", "acceptance_status", "acceptance_receipt_path", "acceptance_receipt_hash", "evidence_refs", "evidence_hash", "uncovered_scope", "completion_class", "written_at", "proof_hash"],
  "properties": {
    "version": { "const": 1 },
    "proof_id": { "type": "string", "minLength": 1 },
    "parent_goal_id": { "type": ["string", "null"] },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_contract_hash": { "type": "string", "minLength": 1 },
    "task_contract_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "owner_fingerprint": { "type": ["string", "null"] },
    "fencing_token": { "type": ["integer", "null"], "minimum": 0 },
    "provider": { "type": "string", "minLength": 1 },
    "model_id": { "type": ["string", "null"] },
    "sandbox_mode": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "terminal_at": { "type": "string", "minLength": 1 },
    "terminal_status": { "enum": ["succeeded", "failed", "blocked"] },
    "terminal_event_id": { "type": ["string", "null"] },
    "input_hash": { "type": "string", "minLength": 1 },
    "output_hash": { "type": "string", "minLength": 1 },
    "structured_result_hash": { "type": "string", "minLength": 1 },
    "workspace_before_hash": { "type": ["string", "null"] },
    "workspace_after_hash": { "type": ["string", "null"] },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "changed_files_hash": { "type": ["string", "null"] },
    "allowed_paths_hash": { "type": ["string", "null"] },
    "workspace_boundary_valid": { "type": "boolean" },
    "acceptance_status": { "enum": ["passed", "skipped", "not_required", "not_run", "failed"] },
    "acceptance_receipt_path": { "type": ["string", "null"] },
    "acceptance_receipt_hash": { "type": ["string", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_hash": { "type": "string", "minLength": 1 },
    "uncovered_scope": { "type": "array", "items": { "type": "string" } },
    "completion_class": { "enum": ["verified", "implemented_not_verified", "analysis_unverified", "invalid"] },
    "written_at": { "type": "string", "minLength": 1 },
    "proof_hash": { "type": "string", "minLength": 1 }
  }
}
