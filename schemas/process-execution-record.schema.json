{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.local/schemas/process-execution-record.schema.json",
  "title": "CodexPro Process Execution Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "execution_id", "correlation_id", "task_id", "run_id", "step_id", "domain", "operation", "command_fingerprint", "cwd", "side_effect_level", "risk_level", "owner_fingerprint", "fencing_token", "pid", "started_at", "last_heartbeat_at", "last_progress_at", "finished_at", "duration_ms", "exit_code", "signal", "termination_reason", "tree_terminated", "stdout_bytes", "stderr_bytes", "output_truncated", "stdout_hash", "stderr_hash", "error_class", "retry_count", "evidence_path"],
  "properties": {
    "version": { "const": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "step_id": { "type": ["string", "null"] },
    "domain": { "enum": ["shell", "git", "model", "worker", "hook", "notification", "adapter", "probe", "server"] },
    "operation": { "type": "string", "minLength": 1 },
    "command_fingerprint": { "type": "string", "minLength": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "side_effect_level": { "enum": ["none", "local_read", "local_write", "external_write"] },
    "risk_level": { "type": "string", "minLength": 1 },
    "owner_fingerprint": { "type": ["string", "null"] },
    "fencing_token": { "type": ["integer", "null"], "minimum": 0 },
    "pid": { "type": ["integer", "null"], "minimum": 0 },
    "started_at": { "type": "string", "minLength": 1 },
    "last_heartbeat_at": { "type": ["string", "null"] },
    "last_progress_at": { "type": ["string", "null"] },
    "finished_at": { "type": "string", "minLength": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": ["integer", "null"] },
    "signal": { "type": ["string", "null"] },
    "termination_reason": { "type": ["string", "null"] },
    "tree_terminated": { "type": "boolean" },
    "stdout_bytes": { "type": "integer", "minimum": 0 },
    "stderr_bytes": { "type": "integer", "minimum": 0 },
    "output_truncated": { "type": "boolean" },
    "stdout_hash": { "type": "string" },
    "stderr_hash": { "type": "string" },
    "error_class": { "type": ["string", "null"] },
    "retry_count": { "type": "integer", "minimum": 0 },
    "evidence_path": { "type": "string", "minLength": 1 }
  }
}
