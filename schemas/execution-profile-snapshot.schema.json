{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.local/schemas/execution-profile-snapshot.schema.json",
  "title": "Execution Profile Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "snapshot_id",
    "snapshot_version",
    "parent_snapshot_id",
    "reason",
    "created_at",
    "goal_id",
    "run_id",
    "provider",
    "model",
    "model_profile_id",
    "model_resolution",
    "reasoning_effort",
    "execution_lane",
    "reviewer_mode",
    "tool_policy",
    "permission_policy",
    "sandbox_policy",
    "mcp_profile",
    "context_profile",
    "working_directory",
    "environment_policy",
    "policy_version",
    "adapter_version",
    "task_contract_hash",
    "profile_hash"
  ],
  "properties": {
    "version": { "const": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "snapshot_version": { "type": "integer", "minimum": 1 },
    "parent_snapshot_id": { "type": ["string", "null"] },
    "reason": { "enum": ["goal_start", "legacy_migration", "explicit_upgrade", "lane_escalation"] },
    "created_at": { "type": "string", "minLength": 1 },
    "goal_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["sdk", "exec", "mock"] },
    "model": { "type": ["string", "null"] },
    "model_profile_id": { "type": ["string", "null"] },
    "model_resolution": { "enum": ["explicit", "registry", "provider_default", "legacy"] },
    "reasoning_effort": { "enum": ["minimal", "low", "medium", "high", "xhigh", null] },
    "execution_lane": { "type": "object" },
    "reviewer_mode": { "enum": ["deterministic", "conditional", "required"] },
    "tool_policy": { "type": "object" },
    "permission_policy": { "type": "object" },
    "sandbox_policy": { "type": "object" },
    "mcp_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "protocol_version", "tool_mode"],
      "properties": {
        "profile": { "enum": ["v1", "v2"] },
        "protocol_version": { "enum": ["2024-11-05", "2025-11-25"] },
        "tool_mode": { "enum": ["minimal", "progressive", "standard", "full"] }
      }
    },
    "context_profile": { "type": "object" },
    "working_directory": { "type": "string", "minLength": 1 },
    "environment_policy": { "type": "object" },
    "policy_version": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "object" },
    "task_contract_hash": { "type": "string", "minLength": 1 },
    "profile_hash": { "type": "string", "minLength": 1 }
  }
}
