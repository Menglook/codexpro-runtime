{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.dev/schemas/gold-task-completion-proof.schema.json",
  "title": "CodexPro Gold Task Completion Proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "suite_run_id", "suite_id", "task_id", "measurement_phase", "runtime_version",
    "runtime_git_sha", "baseline_commit", "client_outcome", "evaluated_outcome", "started_at", "finished_at",
    "acceptance_passed", "execution_origin_verified", "runtime_committed", "control_workspace_unchanged",
    "recorder_error_count", "tool_call_count", "wall_clock_duration_ms", "expected_changed_paths",
    "actual_changed_paths", "unexpected_changed_paths", "missing_changed_paths", "forbidden_changed_paths",
    "usage_entry_ids", "execution_origin_receipt_paths", "verified", "proof_hash"
  ],
  "properties": {
    "version": { "const": 1 },
    "suite_run_id": { "$ref": "#/$defs/nonEmptyString" },
    "suite_id": { "$ref": "#/$defs/nonEmptyString" },
    "task_id": { "$ref": "#/$defs/nonEmptyString" },
    "measurement_phase": { "enum": ["baseline", "candidate"] },
    "runtime_version": { "$ref": "#/$defs/nonEmptyString" },
    "runtime_git_sha": { "$ref": "#/$defs/sha" },
    "baseline_commit": { "$ref": "#/$defs/sha" },
    "client_outcome": { "$ref": "#/$defs/outcome" },
    "evaluated_outcome": { "$ref": "#/$defs/outcome" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "acceptance_passed": { "type": "boolean" },
    "execution_origin_verified": { "type": "boolean" },
    "runtime_committed": { "type": "boolean" },
    "control_workspace_unchanged": { "type": "boolean" },
    "recorder_error_count": { "$ref": "#/$defs/count" },
    "progress_error_count": { "$ref": "#/$defs/count" },
    "tool_call_count": { "$ref": "#/$defs/count" },
    "tool_call_record_count": { "$ref": "#/$defs/count" },
    "nested_dispatch_count": { "$ref": "#/$defs/count" },
    "connector_request_limit": { "$ref": "#/$defs/count" },
    "connector_request_budget_exceeded_count": { "$ref": "#/$defs/count" },
    "connector_request_evidence_consistent": { "type": "boolean" },
    "wall_clock_duration_ms": { "$ref": "#/$defs/count" },
    "change_scope_mode": { "enum": ["exact", "behavioral"] },
    "change_scope_satisfied": { "type": "boolean" },
    "candidate_head_sha": { "$ref": "#/$defs/sha" },
    "git_head_unchanged": { "type": "boolean" },
    "git_index_clean": { "type": "boolean" },
    "failure_classification": { "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "stop_reason": { "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }] },
    "last_progress_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "supervisor_terminated": { "type": "boolean" },
    "tree_terminated": { "type": "boolean" },
    "completion_check_passed": { "type": "boolean" },
    "staged_changed_paths": { "$ref": "#/$defs/stringArray" },
    "expected_changed_paths": { "$ref": "#/$defs/stringArray" },
    "actual_changed_paths": { "$ref": "#/$defs/stringArray" },
    "evaluator_owned_changed_paths": { "$ref": "#/$defs/stringArray" },
    "unexpected_changed_paths": { "$ref": "#/$defs/stringArray" },
    "missing_changed_paths": { "$ref": "#/$defs/stringArray" },
    "forbidden_changed_paths": { "$ref": "#/$defs/stringArray" },
    "usage_entry_ids": { "$ref": "#/$defs/stringArray" },
    "execution_origin_receipt_paths": { "$ref": "#/$defs/stringArray" },
    "verified": { "type": "boolean" },
    "proof_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "count": { "type": "integer", "minimum": 0 },
    "outcome": { "enum": ["passed", "failed", "blocked", "cancelled"] },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }
  }
}
