{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexpro.local/schemas/usage-entry.schema.json",
  "title": "CodexPro Usage Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "usage_id", "dedupe_key", "source_event_id", "task_id", "run_id", "execution_id", "agent_id", "step_id", "component", "provider", "model", "tool", "started_at", "finished_at", "wall_duration_ms", "queue_duration_ms", "active_duration_ms", "silent_duration_ms", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "token_measurement", "input_bytes", "output_bytes", "process_count", "retry_count", "cache_hit", "outcome", "verified_completion", "skill_id", "refresh_count", "rebind_count", "reconnect_count", "recovery_count", "human_wait_ms", "review_duration_ms", "evidence_hash", "written_at"],
  "properties": {
    "external_call_id": { "type": ["string", "null"], "minLength": 1 },
    "external_call_domain": { "type": ["string", "null"], "minLength": 1 },
    "external_call_state": {
      "type": ["string", "null"],
      "enum": ["not_sent", "sending", "acknowledged", "executing", "completed", "failed", "delivery_unknown", null]
    },
    "external_call_attempt": { "type": ["integer", "null"], "minimum": 1 },
    "external_call_idempotency_key": { "type": ["string", "null"], "minLength": 1 },
    "version": { "const": 1 },
    "usage_id": { "type": "string", "minLength": 1 },
    "dedupe_key": { "type": "string", "minLength": 1 },
    "source_event_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "execution_id": { "type": ["string", "null"] },
    "agent_id": { "type": ["string", "null"] },
    "step_id": { "type": ["string", "null"] },
    "component": { "enum": ["model", "process", "tool", "worker", "acceptance", "review", "message", "agent", "browser"] },
    "provider": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "tool": { "type": ["string", "null"] },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "wall_duration_ms": { "type": "integer", "minimum": 0 },
    "queue_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "active_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "silent_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "reasoning_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "token_measurement": { "enum": ["measured", "estimated", "unavailable"] },
    "input_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "output_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "process_count": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "cache_hit": { "type": ["boolean", "null"] },
    "outcome": { "type": "string", "minLength": 1 },
    "verified_completion": { "type": "boolean" },
    "skill_id": { "type": ["string", "null"] },
    "refresh_count": { "type": ["integer", "null"], "minimum": 0 },
    "rebind_count": { "type": ["integer", "null"], "minimum": 0 },
    "reconnect_count": { "type": ["integer", "null"], "minimum": 0 },
    "recovery_count": { "type": ["integer", "null"], "minimum": 0 },
    "human_wait_ms": { "type": ["integer", "null"], "minimum": 0 },
    "review_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "evidence_hash": { "type": "string", "minLength": 1 },
    "written_at": { "type": "string", "minLength": 1 }
  }
}
