{
  "manifest_version": 3,
  "name": "CodexPro Browser Bridge",
  "version": "2.1.0",
  "description": "Optional helper for manually binding an already-open tab; CodexPro-owned tabs open directly without per-tab authorization.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CodexPro Browser Bridge",
    "default_popup": "popup.html"
  }
}
